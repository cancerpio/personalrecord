#!/usr/bin/env bash
# agent-wt：在沙箱內用 git worktree + tmux 平行跑多個 agent
#
#   agent-wt new  <name> [claude|codex] [prompt|@file]   建 worktree + 分支 agent/<name>，在 tmux 開一個 agent
#   agent-wt ls                                          列出 worktree 與 tmux 視窗
#   agent-wt diff <name>                                 看 agent/<name> 相對 base 的變更
#   agent-wt attach                                      進入 tmux session
#   agent-wt rm   <name> [--force]                       關 agent、移除 worktree（分支保留）
#
# 環境變數：
#   BASE=<ref>        新分支起點（預設目前分支）
#   SESSION=<name>    tmux session 名稱（預設 agents）
#   CLAUDE_CMD / CODEX_CMD  覆寫 agent 啟動指令
set -euo pipefail

SESSION="${SESSION:-agents}"
SP_DIR="/opt/superpowers"

die() { echo "agent-wt: $*" >&2; exit 1; }

# 防火牆守衛：沒有防火牆就不要放 agent 出去（與 shell 的 cc/cx 同一道）
guard() {
  [ -f /run/firewall-ok ] && return 0
  [ "${ALLOW_NO_FIREWALL:-0}" = "1" ] && return 0
  die "防火牆未就緒，拒絕啟動 agent。檢查：sudo /usr/local/share/init-firewall.sh"
}

# 不論在主目錄或某個 worktree 裡執行，都找回主 repo
COMMON_DIR="$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null)" || die "不在 git repo 內"
ROOT="$(dirname "$COMMON_DIR")"
WT_DIR="$ROOT/.worktrees"
REPO_NAME="$(basename "$ROOT")"

ensure_excludes() {
  local ex="$COMMON_DIR/info/exclude"
  mkdir -p "$(dirname "$ex")"; touch "$ex"
  for p in ".worktrees/" ".agent.env" ".agent/"; do
    grep -qxF "$p" "$ex" || echo "$p" >> "$ex"
  done
}

port_for() {  # 依名稱算出固定 port，避免平行 agent 搶 port
  local h; h=$(printf %s "$1" | cksum | cut -d' ' -f1)
  echo $(( 3100 + (h % 80) * 10 ))
}

launch() {  # $1=name $2=path $3=agent $4=prompt
  local name="$1" path="$2" agent="$3" prompt="${4:-}" base
  case "$agent" in
    claude) base="${CLAUDE_CMD:-claude --dangerously-skip-permissions}" ;;
    codex)  base="${CODEX_CMD:-codex --dangerously-bypass-approvals-and-sandbox}" ;;
    *) die "未知 agent：$agent（claude|codex）" ;;
  esac

  # 規則與 prompt 都不走命令列。
  # 舊版把整份 AGENTS.md 用 printf %q 內嵌、外層再 %q 一次，中文每個字會展開成
  # 多個八進位跳脫，長度爆增後撞上 tmux 的 "command too long"。
  # 改成產生一支 runner 腳本，內容在腳本裡才展開，tmux 只拿到一個路徑。
  mkdir -p "$path/.agent"
  [ -n "$prompt" ] && printf '%s' "$prompt" > "$path/.agent/prompt.txt"

  local runner="$path/.agent/run.sh"
  {
    echo '#!/usr/bin/env bash'
    echo 'set -u'
    echo '[ -f .agent.env ] && { set -a; . ./.agent.env; set +a; }'
    echo 'args=()'
    if [ "$agent" = claude ]; then
      [ -d "$SP_DIR/.claude-plugin" ] &&
        printf 'args+=(--plugin-dir %s)\n' "$(printf %q "$SP_DIR")"
      # 規則來源固定是主 repo 根目錄那份（容器內唯讀掛載），
      # 不是 worktree 裡那份可寫的 checkout——否則 agent 改得動自己的規則。
      [ -r "$ROOT/AGENTS.md" ] &&
        printf 'args+=(--append-system-prompt "$(cat %s)")\n' "$(printf %q "$ROOT/AGENTS.md")"
    fi
    [ -n "$prompt" ] && echo 'args+=("$(cat .agent/prompt.txt)")'
    printf '%s "${args[@]}"\n' "$base"
    echo 'exec bash'
  } > "$runner"
  chmod +x "$runner"

  if tmux has-session -t "$SESSION" 2>/dev/null; then
    tmux new-window -t "$SESSION" -n "$name" -c "$path" "$runner"
  else
    tmux new-session -d -s "$SESSION" -n "$name" -c "$path" "$runner"
  fi
  echo "agent-wt: [$agent] 已在 tmux $SESSION:$name 啟動 → agent-wt attach"
}

cmd_new() {
  guard
  local name="${1:?用法: agent-wt new <name> [claude|codex] [prompt|@file]}"
  local agent="${2:-claude}" prompt="${3:-}"
  [[ "$name" =~ ^[A-Za-z0-9._-]+$ ]] || die "name 只能用英數 . _ -"
  local path="$WT_DIR/$name" branch="agent/$name"
  local base="${BASE:-$(git -C "$ROOT" symbolic-ref --short HEAD)}"
  [ -e "$path" ] && die "$path 已存在"

  if [ "${prompt:0:1}" = "@" ]; then
    local f="${prompt:1}"; [ -f "$f" ] || f="$ROOT/$f"
    [ -f "$f" ] || die "找不到 prompt 檔：${prompt:1}"
    prompt="$(cat "$f")"
  fi

  ensure_excludes
  mkdir -p "$WT_DIR"

  # 偵測 --relative-paths 支援。這裡有兩個踩過的坑，改動前先讀完：
  #   1. 不要 grep 字面上的 "--relative-paths"。git 的 help 印的是
  #      "--[no-]relative-paths"，那個子字串在任何版本都不存在。
  #   2. 不要用 pipeline。本腳本開頭是 set -euo pipefail，而 `git worktree add -h`
  #      的離開碼是 129（usage），pipefail 會讓整條 pipeline 回傳 129，
  #      條件因此永遠成立、一律 fallback 成絕對路徑。
  # v1/v2 兩個 bug 都有，等於相對路徑 worktree 從來沒生效過。
  local rel="--relative-paths" help
  help="$(git worktree add -h 2>&1 || true)"
  case "$help" in
    *relative-paths*) ;;
    *) echo "agent-wt: WARN git < 2.48，改用絕對路徑（主機端 git 將無法操作此 worktree）" >&2
       rel="" ;;
  esac
  # worktree add 失敗時分支仍會被建出來（實測確認），留下孤兒分支會讓同名重試
  # 撞上 "branch already exists"，所以失敗要自己收尾。
  if ! git -C "$ROOT" worktree add $rel -b "$branch" "$path" "$base"; then
    git -C "$ROOT" branch -D "$branch" 2>/dev/null || true
    die "worktree add 失敗（已清掉分支 $branch）。若訊息是 could not write config file，
     表示這個 repo 還沒 bootstrap，請在主機執行：
       git worktree add --relative-paths -b _bootstrap .worktrees/_bootstrap
       git worktree remove .worktrees/_bootstrap && git branch -d _bootstrap"
  fi

  local port; port=$(port_for "$name")
  cat > "$path/.agent.env" <<EOF
AGENT_NAME=$name
PORT=$port
COMPOSE_PROJECT_NAME=${REPO_NAME}-${name}
GIT_AUTHOR_NAME=agent-$name
GIT_COMMITTER_NAME=agent-$name
EOF
  mkdir -p "$path/.agent"

  if [ -x "$ROOT/.worktree-setup.sh" ]; then
    echo "agent-wt: 執行 .worktree-setup.sh"
    (cd "$path" && set -a && . ./.agent.env && set +a && "$ROOT/.worktree-setup.sh")
  fi

  echo "agent-wt: worktree=$path branch=$branch base=$base PORT=$port"
  launch "$name" "$path" "$agent" "$prompt"
}

cmd_ls() {
  git -C "$ROOT" worktree list
  echo
  tmux list-windows -t "$SESSION" -F '#{window_name}  #{pane_current_path}' 2>/dev/null \
    || echo "(沒有 tmux session $SESSION)"
}

cmd_diff() {
  local name="${1:?用法: agent-wt diff <name>}"
  local base="${BASE:-$(git -C "$ROOT" symbolic-ref --short HEAD)}"
  git -C "$ROOT" diff --stat "$base...agent/$name"
  echo; echo "完整 diff：git diff $base...agent/$name"
  if [ -s "$WT_DIR/$name/.agent/QUESTIONS.md" ]; then
    echo; echo "== agent 留下的商業邏輯問題 =="; cat "$WT_DIR/$name/.agent/QUESTIONS.md"
  fi
  return 0
}

cmd_rm() {
  local name="${1:?用法: agent-wt rm <name> [--force]}" force="${2:-}"
  tmux kill-window -t "$SESSION:$name" 2>/dev/null || true
  if [ "$force" = "--force" ]; then
    git -C "$ROOT" worktree remove --force "$WT_DIR/$name"
  else
    git -C "$ROOT" worktree remove "$WT_DIR/$name"
  fi
  echo "agent-wt: 已移除 worktree，分支 agent/$name 保留（merge 後可 git branch -d agent/$name）"
}

case "${1:-}" in
  new)    shift; cmd_new "$@" ;;
  ls)     cmd_ls ;;
  diff)   shift; cmd_diff "$@" ;;
  attach) exec tmux attach -t "$SESSION" ;;
  rm)     shift; cmd_rm "$@" ;;
  *) sed -n '2,15p' "$0"; exit 1 ;;
esac
